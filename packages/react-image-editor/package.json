{
  "name": "@ascentsparksoftware/react-image-editor",
  "version": "1.2.0",
  "description": "Standalone, themeable React 19 image editor built on Fabric.js v7 (MIT). A free, open-source alternative to commercial image editors — crop, rotate, filters, draw, text, redact, export.",
  "keywords": [
    "react",
    "image-editor",
    "fabric",
    "fabricjs",
    "crop",
    "photo-editor",
    "canvas",
    "filters",
    "annotation",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Ascentspark Software Private Limited",
  "homepage": "https://github.com/ascentspark/react-image-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ascentspark/react-image-editor.git"
  },
  "bugs": {
    "url": "https://github.com/ascentspark/react-image-editor/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "jsondiffpatch": "^0.7.3",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "vitest": "^4.0.8"
  }
}
